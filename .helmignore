# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/

# Local credentials, agent state, and development-only fixtures
.aws/
.agents/
.codex/
.env*
values.local*.yaml
tests/
scripts/
.github/
__pycache__/
.venv/
dist/

# Development-only manifests
dev/
